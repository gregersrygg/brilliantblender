{
  "name": "brilliant-blender",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "changelog": "node scripts/new-changelog.mjs",
    "snapshot": "npm run snapshot:tcgdex && npm run snapshot:build",
    "snapshot:tcgdex": "tsx scripts/export-tcgdex.mjs",
    "snapshot:build": "node scripts/build-card-snapshot.mjs",
    "test": "npm run test:scripts",
    "test:scripts": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit-scripts.xml scripts/*.test.mjs src/lib/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "svelte": "5.55.1",
    "tsx": "4.23.15",
    "vite": "8.0.8"
  }
}
